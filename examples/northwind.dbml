}

Table customer_customer_demo {
  customer_id varchar(5) [ref: > customers.customer_id]
  customer_type_id varchar(5) [ref: > customer_demographics.customer_type_id]

  indexes {
    (customer_id, customer_type_id) [pk]
  }
}

Table customer_demographics {
  customer_type_id varchar(5) [pk]
  customer_desc text
}

Table customers {
  customer_id varchar(5) [pk]
  company_name varchar(40) [not null]
  contact_name varchar(30)
  contact_title varchar(30)
  address varchar(60)
  city varchar(15)
  region varchar(15)
  postal_code varchar(10)
  country varchar(15)
  phone varchar(24)
  fax varchar(24)
}

Table employee_territories {
  employee_id smallint [ref: > employees.employee_id]
  territory_id varchar(20) [ref: > territories.territory_id]

  indexes {
    (employee_id, territory_id) [pk]
  }
}

Table employees {
  employee_id smallint [pk]
  last_name varchar(20) [not null]
  first_name varchar(10) [not null]
  title varchar(30)
  title_of_courtesy varchar(25)
  birth_date date
  hire_date date
  address varchar(60)
  city varchar(15)
  region varchar(15)
  postal_code varchar(10)
  country varchar(15)
  home_phone varchar(24)
  extension varchar(4)
  photo bytea
  notes text
  reports_to smallint [ref: > employees.employee_id]
  photo_path varchar(255)
}

Table order_details {
  order_id smallint [ref: > orders.order_id]
  product_id smallint [ref: > products.product_id]
  unit_price real [not null]
  quantity smallint [not null]
  discount real [not null]

  indexes {
    (order_id, product_id) [pk]
  }
}

Table orders {
  order_id smallint [pk]
  customer_id varchar(5) [ref: > customers.customer_id]
  employee_id smallint [ref: > employees.employee_id]
  order_date date
  required_date date
  shipped_date date
  ship_via smallint [ref: > shippers.shipper_id]
  freight real
  ship_name varchar(40)
  ship_address varchar(60)
  ship_city varchar(15)
  ship_region varchar(15)
  ship_postal_code varchar(10)
  ship_country varchar(15)
}

Table products {
  product_id smallint [pk]
  product_name varchar(40) [not null]
  supplier_id smallint [ref: > suppliers.supplier_id]
  category_id smallint [ref: > categories.category_id]
  quantity_per_unit varchar(20)
  unit_price real
  units_in_stock smallint
  units_on_order smallint
  reorder_level smallint
  discontinued integer [not null]
}

Table region {
  region_id smallint [pk]
  region_description varchar(60) [not null]
}

Table shippers {
  shipper_id smallint [pk]
  company_name varchar(40) [not null]
  phone varchar(24)
}

Table suppliers {
  supplier_id smallint [pk]
  company_name varchar(40) [not null]
  contact_name varchar(30)
  contact_title varchar(30)
  address varchar(60)
  city varchar(15)
  region varchar(15)
  postal_code varchar(10)
  country varchar(15)
  phone varchar(24)
  fax varchar(24)
