  partition_id bigint [ref: > p_ci_builds.partition_id]
  project_id bigint [not null]
  source smallint
  pipeline_source "smallint ) partition by list (partition_id"

  indexes {
    (build_id, partition_id) [pk]
  }
}

Table p_ci_build_trace_metadata {
  build_id bigint [ref: > p_ci_builds.id]
  partition_id bigint [ref: > p_ci_job_artifacts.partition_id]
  trace_artifact_id bigint [ref: > p_ci_job_artifacts.id]
  last_archival_attempt_at timestamptz
  archived_at timestamptz
  archival_attempts smallint [not null]
  checksum bytea
  remote_checksum bytea
  project_id bigint

  indexes {
    (build_id, partition_id) [pk]
  }
}

Table p_ci_builds {
  status varchar
  finished_at timestamp
  created_at timestamp
  updated_at timestamp
  started_at timestamp
  coverage float8
  name varchar
  allow_failure boolean [not null]
  stage_idx integer
  tag boolean
  ref varchar
  type varchar
  target_url varchar
  description varchar
  erased_at timestamp
  artifacts_expire_at timestamp
  environment varchar
  when varchar
  queued_at timestamp
  lock_version integer
  coverage_regex varchar
  retried boolean
  protected boolean
  failure_reason integer
  scheduled_at timestamptz
  token_encrypted varchar
  resource_group_id bigint [ref: > ci_resource_groups.id]
  waiting_for_resource_at timestamptz
  processed boolean
  scheduling_type smallint
  id bigint
  stage_id bigint [ref: > p_ci_stages.id]
  partition_id bigint [ref: > p_ci_stages.partition_id]
  auto_canceled_by_partition_id bigint [ref: > p_ci_pipelines.partition_id]
  auto_canceled_by_id bigint [ref: > p_ci_pipelines.id]
  commit_id bigint [ref: > p_ci_pipelines.id]
  erased_by_id bigint
  project_id bigint
  runner_id bigint
  upstream_pipeline_id bigint [ref: > p_ci_pipelines.id]
  user_id bigint
  upstream_pipeline_partition_id bigint [ref: > p_ci_pipelines.partition_id]
  scoped_user_id bigint
  timeout integer
  timeout_source smallint
  exit_code smallint
  debug_trace_enabled boolean

  indexes {
    (id, partition_id) [pk]
  }
}

Table p_ci_builds_partition_overrides {
  build_id bigint [pk, ref: - p_ci_builds.id]
