  encrypted_token_iv text [not null]
  endpoint_identifier text [not null]
  name text [not null]
  payload_example jsonb [not null]
  payload_attribute_mapping jsonb [not null]
  type_identifier smallint [not null]

  indexes {
    (project_id, endpoint_identifier) [unique]
  }
}

Table alert_management_metric_image_upload_states {
