  updated_at timestamptz [not null]
  expire_at timestamptz
  file varchar
  file_store integer
  file_sha256 bytea
  file_format smallint
  file_location smallint
  id bigint
  job_id bigint [not null, ref: > p_ci_builds.id]
  locked smallint
  partition_id bigint [ref: > p_ci_builds.partition_id]
  accessibility smallint [not null]
  file_final_path text
  exposed_as text
  exposed_paths text[]

