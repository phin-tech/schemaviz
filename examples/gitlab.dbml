  pipeline_id bigint [not null, ref: > p_ci_pipelines.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  branch_name text
  status smallint [not null]
  protected_ref boolean [not null]

  indexes {
    (id, partition_id) [pk]
    (pipeline_id, partition_id) [unique]
  }
}

Table p_duo_workflows_checkpoint_blobs {
  id bigint
  workflow_id bigint [not null, ref: > duo_workflows_workflows.id]
  project_id bigint
  namespace_id bigint
  workflow_created_at timestamptz
  created_at timestamptz [not null]
