Table issue_tracker_data {
  id bigint [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  encrypted_project_url varchar
  encrypted_project_url_iv varchar
  encrypted_issues_url varchar
  encrypted_issues_url_iv varchar
  encrypted_new_issue_url varchar
  encrypted_new_issue_url_iv varchar
  integration_id bigint [ref: > integrations.id]
  project_id bigint [ref: > projects.id]
  group_id bigint [ref: > namespaces.id]
  organization_id bigint [ref: > organizations.id]
}

Table issue_user_mentions {
  id bigint [pk]
  issue_id bigint [not null, ref: > issues.id]
  mentioned_users_ids bigint[]
  mentioned_projects_ids bigint[]
  mentioned_groups_ids bigint[]
  note_id bigint [ref: > notes.id]
  namespace_id bigint [ref: > namespaces.id]

  indexes {
    (issue_id, note_id) [unique]
  }
}

Table issues {
  id bigint [pk]
  title varchar
  author_id bigint [ref: > users.id]
  project_id bigint [ref: > projects.id]
  created_at timestamp
  updated_at timestamp
  description text
  milestone_id bigint [ref: > milestones.id]
  iid integer
  updated_by_id bigint [ref: > users.id]
  weight integer
  confidential boolean [not null]
  due_date date
  moved_to_id bigint [ref: > issues.id]
  lock_version integer
  title_html text
  description_html text
  time_estimate integer
  relative_position integer
  service_desk_reply_to varchar
  cached_markdown_version integer
  last_edited_at timestamp
  last_edited_by_id bigint
  discussion_locked boolean
  closed_at timestamptz
  closed_by_id bigint [ref: > users.id]
  state_id smallint [not null]
  duplicated_to_id bigint [ref: > issues.id]
  promoted_to_epic_id bigint [ref: > epics.id]
  health_status smallint
  sprint_id bigint [ref: > sprints.id]
  blocking_issues_count integer [not null]
  upvotes_count integer [not null]
  work_item_type_id bigint
  namespace_id bigint [ref: > namespaces.id]
  start_date date
  imported_from smallint [not null]
  namespace_traversal_ids bigint[]

  indexes {
    (namespace_id, iid) [unique]
    (project_id, iid) [unique]
  }
}

Table iterations_cadences {
  id bigint [pk]
  group_id bigint [not null, ref: > namespaces.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  start_date date
  duration_in_weeks integer
  iterations_in_advance integer
  active boolean [not null]
  automatic boolean [not null]
  title text [not null]
  roll_over boolean [not null]
  description text
  next_run_date date
}

Table jira_connect_installations {
  id bigint [pk]
  client_key varchar
  encrypted_shared_secret varchar
  encrypted_shared_secret_iv varchar
  base_url varchar
  instance_url text
  organization_id bigint [ref: > organizations.id]
  display_url text
  cloud_id text
  jira_api_base_url text
  encrypted_forge_system_token text
  encrypted_forge_system_token_iv text
  forge_installation_xid text
  updated_at timestamptz

  indexes {
    (organization_id, client_key) [unique]
  }
}

Table jira_connect_subscriptions {
  id bigint [pk]
  jira_connect_installation_id bigint [not null, ref: > jira_connect_installations.id]
  namespace_id bigint [not null, ref: > namespaces.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (jira_connect_installation_id, namespace_id) [unique]
  }
}

Table jira_imports {
  id bigint [pk]
  project_id bigint [not null, ref: > projects.id]
  user_id bigint [ref: > users.id]
  label_id bigint [ref: > labels.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  finished_at timestamptz
  jira_project_xid bigint [not null]
  total_issue_count integer [not null]
  imported_issues_count integer [not null]
  failed_to_import_count integer [not null]
  status smallint [not null]
  jid varchar(255)
  jira_project_key varchar(255) [not null]
  jira_project_name varchar(255) [not null]
  scheduled_at timestamptz
  error_message text
}

Table jira_tracker_data {
  id bigint [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  encrypted_url varchar
  encrypted_url_iv varchar
  encrypted_api_url varchar
  encrypted_api_url_iv varchar
  encrypted_username varchar
  encrypted_username_iv varchar
  encrypted_password varchar
  encrypted_password_iv varchar
