Table p_ci_pipeline_processing_data {
  pipeline_id bigint [ref: > p_ci_pipelines.id]
  partition_id bigint [ref: > p_ci_pipelines.partition_id]
  project_id bigint [not null]
  interruptible_protected boolean [not null]

  indexes {
    (pipeline_id, partition_id) [pk]
  }
}

Table p_ci_pipeline_variables {
  encrypted_value text
  encrypted_value_salt varchar
  encrypted_value_iv varchar
  variable_type smallint [not null]
  partition_id bigint [ref: > p_ci_pipelines.partition_id]
  raw boolean [not null]
  id bigint
  pipeline_id bigint [not null, ref: > p_ci_pipelines.id]
  project_id bigint

  indexes {
    (partition_id, id) [pk]
  }
}

Table p_ci_pipelines {
  ref varchar
  sha varchar
  before_sha varchar
  created_at timestamp
  updated_at timestamp
  tag boolean
  yaml_errors text
  committed_at timestamp
  project_id bigint
  status varchar
  started_at timestamp
  finished_at timestamp
  duration integer
  user_id bigint
  lock_version integer
  pipeline_schedule_id bigint [ref: > ci_pipeline_schedules.id]
  source integer
  config_source integer
  protected boolean
  failure_reason integer
  iid integer
  merge_request_id bigint
  source_sha bytea
  target_sha bytea
  external_pull_request_id bigint [ref: > external_pull_requests.id]
  ci_ref_id bigint [ref: > ci_refs.id]
  locked smallint [not null]
  partition_id bigint
  id bigint
  auto_canceled_by_id bigint [ref: > p_ci_pipelines.id]
  auto_canceled_by_partition_id bigint [ref: > p_ci_pipelines.partition_id]
  trigger_id bigint

  indexes {
    (partition_id, id) [pk]
  }
}

Table p_ci_runner_machine_builds {
  partition_id bigint [ref: > p_ci_builds.partition_id]
  build_id bigint [ref: > p_ci_builds.id]
  runner_machine_id bigint [not null]
  project_id bigint

  indexes {
    (partition_id, build_id) [pk]
  }
}

Table p_ci_runtime_environments {
  id bigint
  partition bigint
  project_id bigint [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  environment_key text [not null]

  indexes {
    (id, partition) [pk]
  }
}

Table p_ci_stages {
  project_id bigint
  created_at timestamp
  updated_at timestamp
