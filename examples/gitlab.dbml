  with_highest_role_security_manager integer [not null]
}

Table value_stream_dashboard_aggregations {
  namespace_id bigint [pk, ref: - namespaces.id]
  last_run_at timestamptz
  enabled boolean [not null]
}

Table value_stream_dashboard_counts {
  id bigint
  namespace_id bigint
  count bigint
  recorded_at timestamptz
  metric smallint

  indexes {
    (id, namespace_id, count, recorded_at, metric) [pk]
  }
}

