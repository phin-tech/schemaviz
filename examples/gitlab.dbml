  path text [not null]
  checksum text
  model_type text
  uploader text [not null]
  mount_point text
  secret text

  indexes {
    (id, model_type) [pk]
  }
}

Table alert_management_alert_metric_images {
  id bigint [pk]
  alert_id bigint [not null, ref: > alert_management_alerts.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  file_store smallint
  file text [not null]
  url text
  url_text text
  project_id bigint [ref: > projects.id]
}

Table alert_management_alert_user_mentions {
  id bigint [pk]
  alert_management_alert_id bigint [not null, ref: > alert_management_alerts.id]
  note_id bigint [ref: > notes.id]
  mentioned_users_ids bigint[]
  mentioned_projects_ids bigint[]
  mentioned_groups_ids bigint[]
  project_id bigint [ref: > projects.id]

  indexes {
    (alert_management_alert_id, note_id) [unique]
  }
}

Table alert_management_alerts {
  id bigint [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  started_at timestamptz [not null]
  ended_at timestamptz
  events integer [not null]
  iid integer [not null]
  severity smallint [not null]
  status smallint [not null]
  fingerprint bytea
  issue_id bigint [ref: > issues.id]
  project_id bigint [not null, ref: > projects.id]
  title text [not null]
  description text
  service text
  monitoring_tool text
  hosts text[] [not null]
  payload jsonb [not null]
  environment_id bigint [ref: > environments.id]
  domain smallint

  indexes {
    (project_id, iid) [unique]
  }
}

Table alert_management_http_integrations {
  id bigint [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  project_id bigint [not null, ref: > projects.id]
  active boolean [not null]
