  project_key text
  issues_enabled boolean [not null]
  deployment_type smallint [not null]
  vulnerabilities_issuetype text
  vulnerabilities_enabled boolean [not null]
  jira_issue_transition_automatic boolean [not null]
  integration_id bigint [ref: > integrations.id]
  jira_issue_prefix text
  jira_issue_regex text
  jira_auth_type smallint [not null]
  project_keys text[] [not null]
  customize_jira_issue_enabled boolean
  project_id bigint [ref: > projects.id]
  group_id bigint [ref: > namespaces.id]
  organization_id bigint [ref: > organizations.id]
  jira_check_enabled boolean [not null]
  jira_assignee_check_enabled boolean [not null]
  jira_status_check_enabled boolean [not null]
  jira_exists_check_enabled boolean [not null]
  jira_allowed_statuses_string text
}

Table job_environments {
  id bigint [pk]
  project_id bigint [not null, ref: > projects.id]
  environment_id bigint [not null, ref: > environments.id]
  ci_pipeline_id bigint [not null]
  ci_job_id bigint [not null]
  deployment_id bigint [ref: > deployments.id]
  expanded_environment_name text [not null]
  options jsonb [not null]

  indexes {
    (ci_job_id, environment_id) [unique]
  }
}

Table keys {
  id bigint [pk]
  user_id bigint
  created_at timestamp
  updated_at timestamp
  title varchar
  type varchar
  fingerprint varchar
  public boolean [not null]
  last_used_at timestamp
  fingerprint_sha256 bytea [unique]
  expires_at timestamptz
  expiry_notification_delivered_at timestamptz
  before_expiry_notification_delivered_at timestamptz
  usage_type smallint [not null]
  organization_id bigint [ref: > organizations.id]
}

Table knowledge_graph_enabled_namespaces {
  id bigint [pk]
  root_namespace_id bigint [unique, not null, ref: > namespaces.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table knowledge_graph_excluded_namespaces {
  root_namespace_id bigint [pk, ref: - namespaces.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table label_links {
  id bigint [pk]
  label_id bigint [ref: > labels.id]
  target_id bigint
  target_type varchar
  created_at timestamp
  updated_at timestamp
  namespace_id bigint [ref: > namespaces.id]
}

Table label_priorities {
  id bigint [pk]
  project_id bigint [not null, ref: > projects.id]
  label_id bigint [not null, ref: > labels.id]
  priority integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

