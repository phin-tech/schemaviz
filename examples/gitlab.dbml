  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  resource_group_id bigint [not null, ref: > ci_resource_groups.id]
  build_id bigint [ref: > p_ci_builds.id]
  partition_id bigint [ref: > p_ci_builds.partition_id]
  project_id bigint

  indexes {
    (resource_group_id, build_id) [unique]
  }
}

Table ci_runner_controller_instance_level_scopings {
  id bigint [pk]
  runner_controller_id bigint [unique, not null, ref: > ci_runner_controllers.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table ci_runner_controller_runner_level_scopings {
  id bigint
  runner_controller_id bigint [not null, ref: > ci_runner_controllers.id]
  runner_id bigint [not null, ref: > ci_runners.id]
  runner_type smallint [ref: > ci_runners.runner_type]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (id, runner_type) [pk]
    (runner_controller_id, runner_id, runner_type) [unique]
  }
}

Table ci_runner_controller_runner_level_scopings_instance_type {
  id bigint
  runner_controller_id bigint [not null]
  runner_id bigint [not null]
  runner_type smallint
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (id, runner_type) [pk]
    (runner_controller_id, runner_id, runner_type) [unique]
  }
}

Table ci_runner_controller_tokens {
  id bigint [pk]
  description text
  token_digest text [unique, not null]
  runner_controller_id bigint [not null, ref: > ci_runner_controllers.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  status smallint [not null]
  last_used_at timestamptz
}

Table ci_runner_controllers {
  id bigint [pk]
  description text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  enabled boolean [not null]
  state smallint [not null]
}

Table ci_runner_machines {
  id bigint
  runner_id bigint [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  contacted_at timestamptz
  creation_state smallint [not null]
  executor_type smallint
  runner_type smallint
  config jsonb [not null]
  system_xid text [not null]
  platform text
  architecture text
  revision text
  ip_address text
  version text
  runtime_features jsonb [not null]
  organization_id bigint
  labels jsonb [not null]

  indexes {
    (id, runner_type) [pk]
    (runner_id, runner_type, system_xid) [unique]
  }
}

Table ci_runner_namespaces {
  id bigint [pk]
  runner_id bigint [ref: > group_type_ci_runners.id]
  namespace_id bigint

  indexes {
    (runner_id, namespace_id) [unique]
  }
}

Table ci_runner_projects {
  id bigint [pk]
  runner_id bigint [not null, ref: > project_type_ci_runners.id]
  created_at timestamp
  updated_at timestamp
  project_id bigint

  indexes {
    (runner_id, project_id) [unique]
  }
}

Table ci_runner_taggings {
  id bigint
  tag_id bigint [not null]
  runner_id bigint [not null]
  runner_type smallint
  organization_id bigint
  tag_name text

  indexes {
    (id, runner_type) [pk]
    (tag_id, runner_id, runner_type) [unique]
  }
}

Table ci_runner_taggings_group_type {
  id bigint
  tag_id bigint [not null]
  runner_id bigint [not null, ref: > group_type_ci_runners.id]
  runner_type smallint [ref: > group_type_ci_runners.runner_type]
  organization_id bigint
  tag_name text

  indexes {
    (id, runner_type) [pk]
    (tag_id, runner_id, runner_type) [unique]
  }
}

Table ci_runner_taggings_instance_type {
  id bigint
  tag_id bigint [not null]
  runner_id bigint [not null, ref: > instance_type_ci_runners.id]
  runner_type smallint [ref: > instance_type_ci_runners.runner_type]
  organization_id bigint
  tag_name text

  indexes {
    (id, runner_type) [pk]
    (tag_id, runner_id, runner_type) [unique]
  }
}

Table ci_runner_taggings_project_type {
  id bigint
  tag_id bigint [not null]
  runner_id bigint [not null, ref: > project_type_ci_runners.id]
  runner_type smallint [ref: > project_type_ci_runners.runner_type]
  organization_id bigint
  tag_name text

  indexes {
    (id, runner_type) [pk]
    (tag_id, runner_id, runner_type) [unique]
  }
}

Table ci_runner_versions {
  version text [pk]
  status smallint

  indexes {
    (status, version) [unique]
  }
}

Table ci_runners {
  id bigint
  creator_id bigint
  created_at timestamptz
  updated_at timestamptz
  contacted_at timestamptz
  token_expires_at timestamptz
  public_projects_minutes_cost_factor float8 [not null]
  private_projects_minutes_cost_factor float8 [not null]
  access_level integer [not null]
  maximum_timeout integer
  runner_type smallint
  registration_type smallint [not null]
  creation_state smallint [not null]
  active boolean [not null]
  run_untagged boolean [not null]
  locked boolean [not null]
  name text
  token_encrypted text
  description text
  maintainer_note text
  allowed_plans text[] [not null]
  allowed_plan_ids bigint[] [not null]
  organization_id bigint
  allowed_plan_name_uids smallint[] [not null]
  token_rotation_deadline timestamptz
  uuid uuid

  indexes {
    (id, runner_type) [pk]
    (token_encrypted, runner_type) [unique]
    (uuid, runner_type) [unique]
  }
}

Table ci_running_builds {
  id bigint [pk]
  build_id bigint [unique, not null, ref: > p_ci_builds.id]
  project_id bigint [not null]
  runner_id bigint [not null]
  created_at timestamptz [not null]
  runner_type smallint [not null]
  partition_id bigint [not null, ref: > p_ci_builds.partition_id]
  runner_owner_namespace_xid bigint

  indexes {
    (partition_id, build_id) [unique]
  }
}

